---
/**
 * /koleso-stastia/ — živá mechanika (koleso šťastia na prevádzke), NIE skončená kampaň.
 * 47 interných odkazov na starom webe, dnes 404 → táto stránka to opravuje.
 * Zdroj: plan/wp-texty/koleso-stastia.md. Pätičkový blok a kontakty z dumpu ignorované,
 * tie rieši layout / firma.ts.
 *
 * Ceny 1–4 mali na starom webe hodnotu v eurách (110 €, 55 €, 55 €, 113 €) z roku 2024 —
 * vynechané, nesedia s cenníkom 2026. Odkazy pri "Komplet STK" a "Akčná kamera" viedli na
 * starom webe na /pick-up-servis-vyzdvihnutie-vozidla/ — tá URL na novom webe neexistuje,
 * preto tu ostávajú bez odkazu.
 */
import Web from "../layouts/Web.astro";
import { KONTAKT, REZERVACIA } from "../data/firma";

const CENY = [
  "Komplet STK",
  "Technická kontrola",
  "Emisná kontrola",
  "Kontrola originality",
  "Akčná kamera",
  "Predkontrola",
  "Test tlmičov",
  "Škrabka na ľad",
  "Reflexná páska",
  "Pero",
];
---

<Web
  titul="Koleso šťastia — Easy Check STK Trnava"
  popis="Absolvujte STK, pridajte recenziu a zatočte kolesom šťastia. Hráte o 10 cien — od kompletnej STK až po drobnosti pre vodičov. Priamo u nás v Trnave."
>
  <!-- 1 · hlavička na žltej ploche -->
  <header class="bg-ec-hud border-b-[var(--stroke-thick)] border-ec-cyan/30">
    <div class="max-w-[1100px] mx-auto px-4 py-12 md:py-16">
      <h1 class="t-display text-5xl md:text-7xl">Koleso šťastia</h1>
      <p class="mt-5 text-xl md:text-2xl font-medium max-w-2xl">
        Každý vyhráva.
      </p>
    </div>
  </header>

  <div class="max-w-[1100px] mx-auto px-4 py-10 md:py-16">
    <!-- 2 · tri kroky -->
    <section>
      <h2 class="t-sub text-sm opacity-70">Ako to funguje</h2>
      <ol class="mt-4 grid gap-5 md:grid-cols-3">
        <li class="nb-card bg-ec-paper p-5">
          <span class="nb-tag bg-ec-red text-white">Úkon kontroly</span>
          <div class="t-display text-2xl text-ec-red t-num mt-3">1.</div>
          <div class="t-sub text-base mt-1">Absolvujte kontrolu</div>
          <p class="mt-2 text-sm opacity-80">
            Prídite s vozidlom na pravidelnú kontrolu STK.
          </p>
        </li>
        <li class="nb-card bg-ec-paper p-5">
          <span class="nb-tag bg-ec-green text-white">Ide to hladko</span>
          <div class="t-display text-2xl text-ec-green t-num mt-3">2.</div>
          <div class="t-sub text-base mt-1">Pridajte recenziu</div>
          <p class="mt-2 text-sm opacity-80">
            Napíšte nám pár slov na Google.
          </p>
          <a
            href="https://g.page/EASYCheckStkEkKo/review?rc"
            target="_blank"
            rel="noopener"
            class="nb-btn mt-4 text-sm !bg-ec-paper"
          >
            Pridať recenziu
          </a>
        </li>
        <li class="nb-card bg-ec-paper p-5">
          <span class="nb-tag bg-ec-green text-white">Ide to hladko</span>
          <div class="t-display text-2xl text-ec-green t-num mt-3">3.</div>
          <div class="t-sub text-base mt-1">Zatočte kolesom</div>
          <p class="mt-2 text-sm opacity-80">
            Hráte až o 10 cien!
          </p>
        </li>
      </ol>
    </section>

    <!-- 3 · zoznam cien, presné poradie zo starého webu -->
    <section class="mt-14 md:mt-20">
      <h2 class="t-display text-3xl md:text-4xl">Čo si môžete vytočiť?</h2>
      <ol class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          CENY.map((cena, i) => (
            <li class="nb bg-ec-paper px-4 py-3 nb-shadow-sm flex items-baseline gap-3">
              <span class="t-num t-sub text-sm text-ec-green">{i + 1}.</span>
              <span class="t-sub text-sm md:text-base">{cena}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 4 · CTA — bez kontroly sa nekrúti -->
    <section class="mt-14 md:mt-20 nb-card border-ec-green/60 p-6 md:p-8">
      <div class="t-display text-2xl md:text-3xl">Najprv kontrola, potom koleso</div>
      <p class="mt-2 text-white/90 max-w-xl">
        Bez absolvovanej kontroly sa koleso nekrúti. Dohodnite si termín vopred,
        nech sa netočíte zbytočne v čakárni.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={REZERVACIA} class="nb-btn text-sm !bg-ec-paper !text-ec-ink">Rezervovať termín</a>
        <a href={KONTAKT.telHref} class="nb-btn text-sm t-num !bg-ec-paper !text-ec-ink">{KONTAKT.tel}</a>
      </div>
    </section>
  </div>
</Web>
