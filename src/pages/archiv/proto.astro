---
import Var from "../../layouts/Var.astro";
import {
  FIRMA, REZERVACIA, HERO, USP, PONUKA, KAT_FARBA,
  DOSTUPNOST, VYHODY_LUDIA, VYHODY_FIRMY, CENY,
} from "../../data/obsah";

const marquee = ["Termín ihneď", "Non-stop", "Bez stresu", "Všetko na jednom mieste", "Víkendy aj sviatky", "Garancia do 24 hodín"];
---

<Var
  titul="Easy Check — STK Trnava"
  variant="PROTOTYP — Žltá stena v2"
  popis="Nadpis skrátený, farebná logika podľa loga, pridaný pohyb"
  bg="bg-ec-yellow"
>
  <!-- ================= HERO ================= -->
  <section class="border-b-[var(--stroke-thick)] border-ec-ink bg-ec-yellow nb-dots overflow-hidden">
    <div class="max-w-[1200px] mx-auto px-4 py-14 md:py-20">
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
        <div>
          <div class="nb-in flex flex-wrap gap-2 items-center">
            <span class="nb-tag bg-ec-red text-white nb-pulse">Termín ihneď</span>
            <span class="nb-tag bg-ec-paper">Trnava · Farárske 27</span>
          </div>

          <!-- nadpis: úder, nie stena -->
          <h1 class="t-display text-[clamp(3.5rem,11vw,9rem)] mt-6 nb-in nb-in-1">
            {HERO.nadpis}
          </h1>

          <p class="mt-6 text-xl md:text-2xl max-w-[30ch] leading-snug nb-in nb-in-2">
            {HERO.lead}
          </p>
          <p class="mt-2 text-base opacity-70 nb-in nb-in-2">{HERO.pod}</p>

          <div class="mt-9 flex flex-col sm:flex-row gap-4 nb-in nb-in-3">
            <a href={REZERVACIA} class="nb-btn !bg-ec-ink !text-ec-yellow text-base md:text-lg !px-8 !py-4">
              Rezervovať termín
            </a>
            <a href={FIRMA.telHref} class="nb-btn !bg-ec-paper text-base md:text-lg !px-8 !py-4 t-num">
              {FIRMA.tel}
            </a>
          </div>
        </div>

        <!-- hodnotenie ako razítko -->
        <div class="nb-in nb-in-4 flex justify-center lg:justify-end">
          <div class="nb-card bg-ec-paper p-8 nb-tilt-r max-w-[320px] w-full text-center">
            <div class="t-display text-[5.5rem] leading-none t-num" data-count={FIRMA.recenzie}>0</div>
            <div class="t-sub text-xs mt-1">recenzií na Google</div>
            <div class="border-t-[var(--stroke)] border-ec-ink my-4"></div>
            <div class="t-display text-4xl text-ec-green t-num">{FIRMA.hodnotenie} ★</div>
            <p class="text-sm mt-2 leading-snug">Najviac hodnotená STK na Slovensku.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE ================= -->
  <section class="bg-ec-ink border-b-[var(--stroke-thick)] border-ec-ink py-3 overflow-hidden">
    <div class="nb-marquee">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0">
            {marquee.map((m) => (
              <span class="t-display text-2xl md:text-3xl text-ec-yellow px-6 flex items-center gap-6 whitespace-nowrap">
                {m}
                <span class="text-ec-red">★</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= PONUKA ================= -->
  <section class="py-16 md:py-24 bg-ec-yellow border-b-[var(--stroke-thick)] border-ec-ink">
    <div class="max-w-[1200px] mx-auto px-4">
      <div class="flex items-end justify-between gap-6 flex-wrap mb-10">
        <h2 class="t-display text-4xl md:text-6xl reveal">Naša ponuka</h2>
        <!-- legenda farebnej logiky -->
        <div class="flex gap-2 flex-wrap reveal reveal-1">
          <span class="nb-tag bg-ec-red text-white">Kontroly</span>
          <span class="nb-tag bg-ec-green text-white">Vybavíme za vás</span>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          PONUKA.map((p, i) => (
            <div class={`nb-card nb-lift p-6 flex flex-col reveal reveal-${(i % 5) + 1} ${KAT_FARBA[p.kat]}`}>
              <h3 class="t-display text-2xl md:text-3xl">{p.nadpis}</h3>
              <p class="mt-3 text-sm leading-relaxed flex-1 opacity-95">{p.text}</p>
              <a href={p.href} class="mt-5 t-sub text-xs inline-flex items-center gap-1.5 self-start border-b-[var(--stroke)] border-current pb-0.5">
                {p.cta} →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= DOSTUPNOSŤ (cyan = vysvetlenie) ================= -->
  <section class="py-16 md:py-24 bg-ec-paper border-b-[var(--stroke-thick)] border-ec-ink">
    <div class="max-w-[1200px] mx-auto px-4">
      <div class="reveal">
        <span class="nb-tag bg-ec-cyan text-white">Kedykoľvek, bez čakania a stresu</span>
        <h2 class="t-display text-4xl md:text-6xl mt-5 max-w-[16ch]">STK už nemusí byť nočná mora!</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3 mt-10">
        {
          DOSTUPNOST.map((d, i) => (
            <div class={`nb-card p-6 bg-ec-cyan text-white reveal reveal-${i + 1}`}>
              <span class="nb-tag bg-white !text-ec-ink">{d.stitok}</span>
              <h3 class="t-display text-2xl mt-4">{d.nadpis}</h3>
              <p class="mt-2 text-sm leading-relaxed opacity-95">{d.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= VÝHODY (green = easy) ================= -->
  <section class="py-16 md:py-24 bg-ec-yellow border-b-[var(--stroke-thick)] border-ec-ink">
    <div class="max-w-[1200px] mx-auto px-4">
      <h2 class="t-display text-4xl md:text-6xl mb-10 reveal">STK s výhodami</h2>
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="reveal">
          <div class="nb-tag bg-ec-green text-white text-sm mb-4">Pre ľudí</div>
          <div class="space-y-4">
            {VYHODY_LUDIA.map((v) => (
              <div class="nb-card p-5 bg-ec-green text-white">
                <h3 class="t-sub text-base">{v.nadpis}</h3>
                <p class="mt-1.5 text-sm leading-relaxed opacity-95">{v.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="reveal reveal-2">
          <div class="nb-tag bg-ec-green text-white text-sm mb-4">Pre firmy</div>
          <div class="space-y-4">
            {VYHODY_FIRMY.map((v) => (
              <div class="nb-card p-5 bg-ec-green text-white">
                <h3 class="t-sub text-base">{v.nadpis}</h3>
                <p class="mt-1.5 text-sm leading-relaxed opacity-95">{v.text}</p>
              </div>
            ))}
            <div class="nb-card p-0 overflow-hidden">
              <img src="/foto/img_4128.jpg" alt="Easy Check Trnava" class="w-full h-[168px] object-cover object-[center_28%] block" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CENNÍK ================= -->
  <section class="py-16 md:py-24 bg-ec-paper border-b-[var(--stroke-thick)] border-ec-ink">
    <div class="max-w-[1200px] mx-auto px-4 grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-center">
      <div class="reveal">
        <h2 class="t-display text-4xl md:text-5xl">Cenník bez prekvapení</h2>
        <p class="mt-4 text-sm leading-relaxed max-w-[42ch] opacity-80">
          Cenník je o čosi vyšší ako konkurencia. Šetríme vám ale to najcennejšie — čas.
        </p>
        <a href="/cennik" class="nb-btn mt-6 text-sm">Celý cenník</a>
      </div>
      <div class="nb-card p-0 overflow-hidden reveal reveal-2">
        <table class="w-full text-sm">
          <tbody>
            {
              CENY.map((c, i) => (
                <tr class={i % 2 ? "bg-black/[0.03]" : ""}>
                  <td class="px-5 py-3.5 border-b border-ec-ink/15">
                    <div class="t-sub text-xs">{c.co}</div>
                    <div class="text-xs opacity-60 mt-0.5">{c.pozn}</div>
                  </td>
                  <td class="px-5 py-3.5 border-b border-ec-ink/15 text-right t-display text-xl t-num whitespace-nowrap">
                    {c.cena}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE 2 (opačný smer) ================= -->
  <section class="bg-ec-red border-b-[var(--stroke-thick)] border-ec-ink py-3 overflow-hidden">
    <div class="nb-marquee nb-marquee-rev nb-marquee-fast">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0">
            {["Za drobnosť vás nevyhodíme", "Sme STK pre ľudí", "Nepovieme vám nie"].map((m) => (
              <span class="t-display text-2xl md:text-3xl text-white px-6 flex items-center gap-6 whitespace-nowrap">
                {m}
                <span class="text-ec-yellow">★</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="py-20 md:py-28 bg-ec-yellow nb-dots">
    <div class="max-w-[1200px] mx-auto px-4">
      <div class="nb-card bg-ec-ink p-10 md:p-16 text-center reveal">
        <span class="nb-tag bg-ec-red text-white nb-pulse">Garancia do 24 hodín</span>
        <h2 class="t-display text-4xl md:text-7xl text-ec-yellow mt-6">Nepovieme vám nie</h2>
        <p class="mt-4 text-ec-paper/85 text-lg max-w-[46ch] mx-auto">
          Stačí sa objednať alebo zavolať a už dnes môžete byť na linke.
        </p>
        <div class="mt-9 flex flex-col sm:flex-row gap-4 justify-center">
          <a href={REZERVACIA} class="nb-btn text-base !px-8 !py-4">Rezervovať termín</a>
          <a href={FIRMA.telHref} class="nb-btn !bg-ec-paper text-base !px-8 !py-4 t-num">{FIRMA.tel}</a>
        </div>
      </div>
    </div>
  </section>
</Var>

<script>
  // --- odkrývanie blokov pri scrollovaní ---
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: "0px 0px -60px 0px" }
  );
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

  // --- narátanie počtu recenzií ---
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  const co = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      const cieł = Number(el.dataset.count || 0);
      const trvanie = 1400;
      const start = performance.now();
      const krok = (t: number) => {
        const p = Math.min((t - start) / trvanie, 1);
        // ease-out — spomalí na konci
        const e2 = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(cieł * e2).toLocaleString("sk-SK");
        if (p < 1) requestAnimationFrame(krok);
      };
      requestAnimationFrame(krok);
      co.unobserve(el);
    });
  }, { threshold: 0.5 });
  counters.forEach((el) => co.observe(el));
</script>
