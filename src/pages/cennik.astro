---
/**
 * /cennik/ — kompletný cenník STK, EK, KO a ODOPASS.
 * Ceny výhradne z vstupy/MASTERPROMPT.md §8 (jediný platný zdroj, 2026).
 * Staré ceny z WP (plan/wp-texty/cennik.md) sa NEPOUŽÍVAJÚ — sú neaktuálne.
 */
import Web from "../layouts/Web.astro";
import { KONTAKT, REZERVACIA } from "../data/firma";
import {
  NAJCASTEJSIE,
  TK_PRAVIDELNA,
  TK_OPAKOVANA,
  ADMINISTRATIVNA,
  EK_PRAVIDELNA,
  EK_OPAKOVANA,
  KO,
  ODOPASS,
} from "../data/cennik";
---

<Web
  titul="Cenník STK, emisnej a kontroly originality 2026"
  popis="Kompletný cenník technickej, emisnej kontroly a kontroly originality Easy Check Trnava na rok 2026. Všetky ceny v eurách vrátane DPH."
>
  <!-- 1 · hlavička na žltej ploche -->
  <header class="bg-ec-hud border-b-[var(--stroke-thick)] border-ec-cyan/30">
    <div class="max-w-[1100px] mx-auto px-4 py-12 md:py-16">
      <h1 class="t-display text-4xl md:text-6xl">Cenník</h1>
      <p class="mt-5 text-xl md:text-2xl font-medium max-w-2xl">
        Bežné osobné auto na benzín alebo diesel: technická kontrola 60 € a emisná kontrola 60 €.
      </p>
      <p class="mt-3 text-sm md:text-base opacity-80">
        Všetky ceny sú v eurách vrátane DPH.
      </p>
    </div>
  </header>

  <div class="max-w-[1100px] mx-auto px-4 py-10 md:py-14">
    <!-- 2 · rýchly blok najčastejšie -->
    <section aria-labelledby="najcastejsie-h">
      <h2 id="najcastejsie-h" class="t-sub text-sm opacity-70">Najčastejšie</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          NAJCASTEJSIE.map((r) => (
            <div class="nb-card bg-ec-paper p-5">
              <span class="nb-tag bg-ec-red text-white">Úkon kontroly</span>
              <div class="t-display text-3xl mt-4 t-num">{r.cena}</div>
              <p class="mt-2 text-sm">{r.vozidlo}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 3 · kompletné tabuľky -->

    <section class="mt-14 md:mt-20">
      <h2 id="tk" class="t-display text-2xl md:text-3xl">Technická kontrola — pravidelná / zvláštna</h2>
      <p class="mt-2 max-w-2xl text-sm md:text-base opacity-80">
        Pravidelná kontrola je v plnom rozsahu. Zvláštna kontrola (napr. po prestavbe vozidla)
        sa vykonáva tiež v plnom rozsahu a stojí rovnako ako pravidelná.
      </p>
      <div class="ec-scroll-x nb nb-shadow-sm mt-5">
        <table class="w-full text-sm md:text-base border-collapse min-w-[420px]">
          <thead>
            <tr class="bg-ec-hud">
              <th class="t-sub text-xs md:text-sm text-left px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Vozidlo
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Cena
              </th>
            </tr>
          </thead>
          <tbody>
            {
              TK_PRAVIDELNA.map((r) => (
                <tr class="border-b border-ec-cyan/15 last:border-b-0">
                  <td class="px-4 py-3">{r.vozidlo}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.cena}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 md:mt-20">
      <h2 id="tk-opakovana" class="t-display text-2xl md:text-3xl">Technická kontrola — opakovaná</h2>
      <p class="mt-2 max-w-2xl text-sm md:text-base opacity-80">
        Ak vozidlo na pravidelnej kontrole nevyhovie, po odstránení závad ide na opakovanú kontrolu
        v čiastočnom rozsahu — kontroluje sa len to, čo bolo predtým chybné. Ak prídete
        v ten istý deň ako na pravidelnú kontrolu, je opakovaná kontrola lacnejšia; do 60 dní
        od pravidelnej kontroly platí vyššia cena.
      </p>
      <div class="ec-scroll-x nb nb-shadow-sm mt-5">
        <table class="w-full text-sm md:text-base border-collapse min-w-[480px]">
          <thead>
            <tr class="bg-ec-hud">
              <th class="t-sub text-xs md:text-sm text-left px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Vozidlo
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                V deň
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Do 60 dní
              </th>
            </tr>
          </thead>
          <tbody>
            {
              TK_OPAKOVANA.map((r) => (
                <tr class="border-b border-ec-cyan/15 last:border-b-0">
                  <td class="px-4 py-3">{r.vozidlo}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.vDen}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.do60}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 md:mt-20">
      <h2 id="administrativna" class="t-display text-2xl md:text-3xl">Administratívna kontrola</h2>
      <p class="mt-2 max-w-2xl text-sm md:text-base opacity-80">
        Administratívna kontrola sa robí namiesto fyzickej kontroly vozidla — napríklad pri
        prepise alebo pri zmene v evidencii — a vychádza z platného protokolu o TK alebo EK.
        Cena je iná, ak bol vozidlo naposledy skontrolované u nás alebo na inej stanici.
      </p>
      <div class="ec-scroll-x nb nb-shadow-sm mt-5">
        <table class="w-full text-sm md:text-base border-collapse min-w-[380px]">
          <thead>
            <tr class="bg-ec-hud">
              <th class="t-sub text-xs md:text-sm text-left px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Kontrola
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Cena
              </th>
            </tr>
          </thead>
          <tbody>
            {
              ADMINISTRATIVNA.map((r) => (
                <tr class="border-b border-ec-cyan/15 last:border-b-0">
                  <td class="px-4 py-3">{r.vozidlo}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.cena}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 md:mt-20">
      <h2 id="ek" class="t-display text-2xl md:text-3xl">Emisná kontrola — pravidelná / zvláštna</h2>
      <p class="mt-2 max-w-2xl text-sm md:text-base opacity-80">
        Pravidelná aj zvláštna emisná kontrola sa vykonáva v plnom rozsahu, cena je rovnaká.
      </p>
      <div class="ec-scroll-x nb nb-shadow-sm mt-5">
        <table class="w-full text-sm md:text-base border-collapse min-w-[420px]">
          <thead>
            <tr class="bg-ec-hud">
              <th class="t-sub text-xs md:text-sm text-left px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Vozidlo
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Cena
              </th>
            </tr>
          </thead>
          <tbody>
            {
              EK_PRAVIDELNA.map((r) => (
                <tr class="border-b border-ec-cyan/15 last:border-b-0">
                  <td class="px-4 py-3">{r.vozidlo}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.cena}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 md:mt-20">
      <h2 id="ek-opakovana" class="t-display text-2xl md:text-3xl">Emisná kontrola — opakovaná</h2>
      <p class="mt-2 max-w-2xl text-sm md:text-base opacity-80">
        Rovnaký princíp ako pri technickej kontrole: v deň pravidelnej kontroly je opakovaná
        kontrola lacnejšia, do 60 dní od pravidelnej platí vyššia cena.
      </p>
      <div class="ec-scroll-x nb nb-shadow-sm mt-5">
        <table class="w-full text-sm md:text-base border-collapse min-w-[480px]">
          <thead>
            <tr class="bg-ec-hud">
              <th class="t-sub text-xs md:text-sm text-left px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Vozidlo
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                V deň
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Do 60 dní
              </th>
            </tr>
          </thead>
          <tbody>
            {
              EK_OPAKOVANA.map((r) => (
                <tr class="border-b border-ec-cyan/15 last:border-b-0">
                  <td class="px-4 py-3">{r.vozidlo}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.vDen}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.do60}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 md:mt-20">
      <h2 id="ko" class="t-display text-2xl md:text-3xl">Kontrola originality (KO)</h2>
      <p class="mt-2 max-w-2xl text-sm md:text-base opacity-80">
        V cene kontroly originality je zahrnuté tlačivo „Odborný posudok". Bezpečnostné
        nálepky a nálepka QR sa pripočítavajú zvlášť — pozrite tabuľku ODOPASS a príslušenstvo nižšie.
      </p>
      <div class="ec-scroll-x nb nb-shadow-sm mt-5">
        <table class="w-full text-sm md:text-base border-collapse min-w-[420px]">
          <thead>
            <tr class="bg-ec-hud">
              <th class="t-sub text-xs md:text-sm text-left px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Vozidlo
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Cena
              </th>
            </tr>
          </thead>
          <tbody>
            {
              KO.map((r) => (
                <tr class="border-b border-ec-cyan/15 last:border-b-0">
                  <td class="px-4 py-3">{r.vozidlo}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.cena}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-14 md:mt-20">
      <h2 id="odopass" class="t-display text-2xl md:text-3xl">ODOPASS a príslušenstvo KO</h2>
      <p class="mt-2 max-w-2xl text-sm md:text-base opacity-80">
        ODOPASS a nálepky sa účtujú k cene kontroly originality podľa toho, koľkokrát bolo vozidlo
        prihlásené (ODOPASS 4/6/7+), a podľa druhu bezpečnostnej nálepky, ktorá sa lepí pri prvej
        kontrole originality.
      </p>
      <div class="ec-scroll-x nb nb-shadow-sm mt-5">
        <table class="w-full text-sm md:text-base border-collapse min-w-[380px]">
          <thead>
            <tr class="bg-ec-hud">
              <th class="t-sub text-xs md:text-sm text-left px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Položka
              </th>
              <th class="t-sub text-xs md:text-sm text-right px-4 py-3 border-b-[var(--stroke)] border-ec-cyan/30">
                Cena
              </th>
            </tr>
          </thead>
          <tbody>
            {
              ODOPASS.map((r) => (
                <tr class="border-b border-ec-cyan/15 last:border-b-0">
                  <td class="px-4 py-3">{r.vozidlo}</td>
                  <td class="px-4 py-3 text-right t-num font-semibold">{r.cena}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4 · CTA — červená = úkon kontroly -->
    <div class="mt-16 md:mt-20 nb-card border-ec-red/60 p-6 md:p-10">
      <div class="t-display text-2xl md:text-4xl">Objednajte si termín</div>
      <p class="mt-3 text-white/90 max-w-xl">
        Termín garantujeme do 24 hodín. Zavolajte, alebo si rezervujte kontrolu priamo online.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={REZERVACIA} class="nb-btn text-sm !bg-ec-paper">Rezervovať termín</a>
        <a href={KONTAKT.telHref} class="nb-btn text-sm">{KONTAKT.tel}</a>
      </div>
    </div>
  </div>
</Web>
