---
/**
 * /sluzby/ — NOVÁ stránka, zlieva 4 staré WP stránky do kotiev jednej stránky:
 * #tachografy, #prihlasovanie, #vyzdvihnutie, #vyhody.
 * Staré URL (/overovanie-tachografov/, /prihlasovanie-vozidiel/,
 * /vyzdvihnutie-vozidla-na-stk/, /stk-s-vyhodami/) sa neskôr presmerujú (301) sem.
 * /kontrola-originality/ je VLASTNÁ stránka, NIE kotva — len sa sem odkazuje.
 */
import Web from "../layouts/Web.astro";
import { KONTAKT, HODINY, REZERVACIA } from "../data/firma";
import { NAV, TACHOGRAFY, PRIHLASOVANIE, VYZDVIHNUTIE, VYHODY } from "../data/sluzby";
---

<Web
  titul="Služby Easy Check — tachografy, prihlásenie, výzdvih"
  popis="Okrem STK a emisnej kontroly u nás vybavíte aj overenie tachografu, prihlásenie vozidla do evidencie, výzdvih vozidla na STK a kontrolu originality."
>
  <!-- 1 · hlavička na žltej ploche -->
  <header class="bg-ec-yellow border-b-[var(--stroke-thick)] border-ec-ink">
    <div class="max-w-[1100px] mx-auto px-4 py-12 md:py-16">
      <h1 class="t-display text-4xl md:text-6xl">Naša ponuka</h1>
      <p class="mt-5 text-xl md:text-2xl font-medium max-w-2xl">
        Okrem technickej a emisnej kontroly u nás na jednom mieste vybavíte aj overenie
        tachografu, prihlásenie vozidla do evidencie a kontrolu originality.
      </p>
    </div>
  </header>

  <div class="max-w-[1100px] mx-auto px-4 py-10 md:py-14">
    <!-- 2 · obsah stránky — rýchla navigácia na kotvy + samostatnú stránku KO -->
    <nav aria-label="Obsah stránky">
      <h2 class="t-sub text-sm opacity-70">Obsah stránky</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          NAV.map((d) => (
            <li>
              <a
                href={d.href}
                class="nb-card nb-lift block h-full p-5 bg-ec-paper"
              >
                <span class={`nb-tag ${d.farba} text-white`}>
                  {d.farba === "bg-ec-red" ? "Úkon kontroly" : "Vybavíme za vás"}
                </span>
                <div class="t-sub text-base mt-3 normal-case tracking-normal flex items-center gap-2">
                  {d.nazov}
                  {d.externa && <span aria-hidden="true">→</span>}
                </div>
                <p class="mt-1 text-sm opacity-70">{d.popis}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- 3a · #tachografy — červená = úkon kontroly -->
    <section id="tachografy" class="mt-14 md:mt-20 scroll-mt-24">
      <span class="nb-tag bg-ec-red text-white">Úkon kontroly</span>
      <h2 class="t-display text-3xl md:text-4xl mt-4">{TACHOGRAFY.nadpis}</h2>
      <p class="mt-3 max-w-2xl text-lg">{TACHOGRAFY.uvod}</p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          TACHOGRAFY.akcie.map((a) => (
            <div class="nb-card bg-ec-red text-white p-5">
              <div class="t-sub text-base">{a.nazov}</div>
              <p class="mt-2 text-sm text-white/90">{a.text}</p>
            </div>
          ))
        }
      </div>

      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          TACHOGRAFY.polozky.map((p) => (
            <li class="nb bg-ec-paper px-4 py-3 text-sm md:text-base nb-shadow-sm">{p}</li>
          ))
        }
      </ul>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={REZERVACIA} class="nb-btn !bg-ec-red text-white">Rezervovať termín</a>
        <a href={KONTAKT.telHref} class="nb-btn !bg-ec-paper">{KONTAKT.tel}</a>
      </div>
    </section>

    <!-- 3b · #prihlasovanie — zelená = ide to hladko -->
    <section id="prihlasovanie" class="mt-14 md:mt-20 scroll-mt-24">
      <span class="nb-tag bg-ec-green text-white">Vybavíme za vás</span>
      <h2 class="t-display text-3xl md:text-4xl mt-4">{PRIHLASOVANIE.nadpis}</h2>
      <p class="mt-3 max-w-2xl text-lg">{PRIHLASOVANIE.uvod}</p>

      <ol class="mt-8 grid gap-5 md:grid-cols-3">
        {
          PRIHLASOVANIE.kroky.map((k, i) => (
            <li class="nb-card bg-ec-paper p-5">
              <div class="t-display text-2xl text-ec-green t-num">{i + 1}</div>
              <div class="t-sub text-base mt-2">{k.nazov}</div>
              <p class="mt-2 text-sm">{k.text}</p>
              {k.doklady && (
                <ul class="mt-3 text-sm opacity-80 list-disc pl-4 space-y-1">
                  {k.doklady.map((d) => <li>{d}</li>)}
                </ul>
              )}
              {k.vyhnete && (
                <div class="mt-3">
                  <div class="text-xs t-sub opacity-60">Čomu sa vyhnete</div>
                  <ul class="mt-1 text-sm opacity-80 list-disc pl-4 space-y-1">
                    {k.vyhnete.map((v) => <li>{v}</li>)}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ol>

      <div class="mt-6">
        <a href={REZERVACIA} class="nb-btn !bg-ec-green text-white">Rezervovať KO + prihlásenie</a>
      </div>
    </section>

    <!-- 3c · #vyzdvihnutie — zelená = ide to hladko -->
    <section id="vyzdvihnutie" class="mt-14 md:mt-20 scroll-mt-24">
      <span class="nb-tag bg-ec-green text-white">Vybavíme za vás</span>
      <h2 class="t-display text-3xl md:text-4xl mt-4">{VYZDVIHNUTIE.nadpis}</h2>
      <p class="mt-3 max-w-2xl text-lg">{VYZDVIHNUTIE.uvod}</p>

      <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          VYZDVIHNUTIE.kroky.map((k, i) => (
            <li class="nb bg-ec-paper px-4 py-3 nb-shadow-sm">
              <span class="t-num t-sub text-xs opacity-60">{i + 1}.</span>
              <span class="t-sub text-sm ml-1">{k.nazov}</span>
              <p class="mt-1 text-sm opacity-80">{k.text}</p>
            </li>
          ))
        }
      </ol>

      <h3 class="t-sub text-sm opacity-70 mt-8">Podmienky výzdvihu</h3>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          VYZDVIHNUTIE.podmienky.map((p) => (
            <li class="text-sm md:text-base flex gap-2">
              <span aria-hidden="true">·</span>
              <span>{p}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-6">
        <a href={REZERVACIA} class="nb-btn !bg-ec-green text-white">Rezervovať termín</a>
      </div>
    </section>

    <!-- 3d · #vyhody — zelená = ide to hladko -->
    <section id="vyhody" class="mt-14 md:mt-20 scroll-mt-24">
      <span class="nb-tag bg-ec-green text-white">Vybavíme za vás</span>
      <h2 class="t-display text-3xl md:text-4xl mt-4">{VYHODY.nadpis}</h2>
      <p class="mt-3 max-w-2xl text-lg">{VYHODY.uvod}</p>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          VYHODY.polozky.map((p) => (
            <li class="nb-card bg-ec-paper p-5">
              <div class="t-sub text-base">{p.nazov}</div>
              <p class="mt-2 text-sm opacity-80">{p.text}</p>
            </li>
          ))
        }
      </ul>

      <!-- presné hodiny — zdroj firma.ts, nie stará stránka (tá mala 07:00–22:00, neaktuálne) -->
      <div class="mt-6 nb bg-ec-paper p-5">
        <div class="t-sub text-sm opacity-70 mb-3">Otváracie hodiny</div>
        <ul class="grid gap-1 text-sm md:text-base sm:grid-cols-2">
          {
            HODINY.map((h) => (
              <li class="flex justify-between gap-4 sm:block">
                <span class="opacity-80">{h.den}</span>
                <span class="t-num font-semibold">{h.cas}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={REZERVACIA} class="nb-btn !bg-ec-green text-white">Rezervovať termín</a>
        <!-- CTA na /koleso-stastia/ zatiaľ preč: tá stránka sa v NOCI 1 nestavala, odkaz by vracal 404.
             Vrátiť, keď stránka vznikne (stará URL ostáva, viď sitemap-stary-web.csv). -->
      </div>
    </section>

    <!-- 4 · odkazy na cenník a kontakt -->
    <div class="mt-14 md:mt-20 nb-card bg-ec-paper p-6 md:p-8">
      <div class="t-display text-2xl md:text-3xl">Chcete presnú cenu alebo nás nájsť?</div>
      <p class="mt-2 max-w-xl opacity-80">
        Kompletný cenník máme na jednom mieste, kontaktné údaje a mapu na druhom.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/cennik/" class="nb-btn">Cenník</a>
        <a href="/kontakt/" class="nb-btn !bg-ec-paper">Kontakt</a>
      </div>
    </div>
  </div>
</Web>
