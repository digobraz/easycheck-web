---
/**
 * CHAT — pilier č. 3 (Matej, 4. 8. 2026).
 *
 * Nie je to len chatovacie okno. Je to jediná stránka, cez ktorú sa zákazník
 * dostane ku VŠETKÉMU, čo nie je v menu: informácie o STK, cenník, služby,
 * tlačivá a všetky ostatné stránky webu.
 *
 * ⚠️ Samotný chat zatiaľ NEODPOVEDÁ — nemá znalostnú bázu ani backend.
 * Vstupné pole je preto vypnuté (`disabled`) a nepredstiera, že funguje.
 * Zvyšok stránky je plnohodnotný a použiteľný už dnes.
 */
import Web from "../layouts/Web.astro";
import { KONTAKT, MIMO_MENU } from "../data/firma";
import { NAV as SLUZBY } from "../data/sluzby";

const OTAZKY = [
  "Kedy ide moje auto na technickú?",
  "Čo si mám vziať so sebou?",
  "Koľko stojí technická a emisná?",
  "Prepadla mi STK — aká je pokuta?",
  "Ako dlho to trvá?",
  "Musím sa objednať vopred?",
  "Aký dezén musia mať pneumatiky?",
  "Čo je kontrola originality a kedy ju potrebujem?",
  "Prihlásite mi vozidlo za mňa?",
  "Robíte overenie tachografu?",
  "Kde vás nájdem?",
  "Kedy máte otvorené?",
];

const NA_STIAHNUTIE = [
  {
    t: "Kompletný cenník 2026",
    pod: "Všetky ceny na jednom liste — TK, EK, KO, tachografy, administratíva.",
    href: "/cennik/",
    akcia: "Otvoriť cenník",
    hotove: true,
  },
  {
    t: "Tlačivá na stiahnutie",
    pod: "Splnomocnenie, žiadosti, formuláre k prihláseniu vozidla.",
    href: `mailto:${KONTAKT.mail}?subject=Prosím o tlačivá`,
    akcia: "Vyžiadať mailom",
    hotove: false,
  },
];

/** Overovacie odkazy — zo starej /uzitocne-informacie/, inde na webe nie sú. */
const OVERENIE = [
  { t: "Overiť platnosť technickej kontroly", href: "https://www.jiscd.sk/" },
  { t: "Overiť platnosť emisnej kontroly", href: "https://www.seka.sk/overenie-vozidla" },
];
---

<Web
  titul="Info — opýtajte sa na STK | Easy Check Trnava"
  popis="Opýtajte sa na technickú, emisnú alebo kontrolu originality. Cenník, tlačivá, lehoty aj všetky informácie o STK Easy Check Trnava na jednom mieste."
>
  <!-- ============ TERMINÁL ============ -->
  <section class="max-w-[1100px] mx-auto px-4 pt-12 md:pt-16 pb-10">
    <div class="t-sub text-[0.7rem] text-ec-cyan">Easy Check · asistent</div>
    <h1 class="t-display text-4xl md:text-6xl mt-3">
      Opýtajte sa <span class="t-glow-y">na čokoľvek</span>
    </h1>
    <p class="mt-5 text-lg md:text-xl text-ec-ink/80 max-w-2xl">
      Technická, emisná, originalita, tachografy, lehoty, ceny aj tlačivá.
      Všetko, čo o nás potrebujete vedieť, je odtiaľto dostupné.
    </p>

    <div class="nb relative mt-8 p-5 md:p-6">
      <span class="nb-corner top-2 left-2 border-r-0 border-b-0"></span>
      <span class="nb-corner bottom-2 right-2 border-l-0 border-t-0"></span>

      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 bg-ec-yellow rounded-full nb-pulse shrink-0"></span>
        <span class="t-sub text-[0.65rem] text-ec-muted">Asistent sa pripravuje</span>
      </div>

      <div class="mt-4 flex flex-col sm:flex-row gap-3">
        <input
          type="text"
          disabled
          placeholder="Napíšte otázku… (zatiaľ nedostupné)"
          aria-label="Otázka pre asistenta"
          class="flex-1 bg-[rgb(5_8_10/0.7)] border border-ec-cyan/25 px-4 py-3.5 text-ec-ink placeholder:text-ec-muted/70 outline-none disabled:cursor-not-allowed"
        />
        <a href={KONTAKT.telHref} class="nb-btn text-sm shrink-0">
          Zavolať {KONTAKT.tel}
        </a>
      </div>

      <p class="mt-4 text-sm text-ec-muted leading-relaxed">
        Chat spustíme, až keď bude odpovedať z overených faktov a ku každej odpovedi
        pridá zdroj. Kým nie je istý, radšej vás spojíme s technikom — odpovie hneď.
      </p>
    </div>
  </section>

  <!-- ============ NA ČO SA ĽUDIA PÝTAJÚ ============ -->
  <section class="max-w-[1100px] mx-auto px-4 py-10">
    <h2 class="t-sub text-sm text-ec-yellow">Na čo sa ľudia pýtajú najčastejšie</h2>
    <ul class="mt-5 flex flex-wrap gap-2.5">
      {
        OTAZKY.map((o) => (
          <li class="nb-tag normal-case tracking-normal font-normal text-[0.85rem] text-ec-ink/85 py-2 px-3.5">
            {o}
          </li>
        ))
      }
    </ul>
    <p class="mt-5 text-sm text-ec-muted">
      Na ktorúkoľvek z nich vám odpovieme na telefóne
      <a href={KONTAKT.telHref} class="text-ec-cyan hover:text-ec-yellow">{KONTAKT.tel}</a>
      alebo mailom
      <a href={`mailto:${KONTAKT.mail}`} class="text-ec-cyan hover:text-ec-yellow"
        >{KONTAKT.mail}</a
      >.
    </p>
  </section>

  <!-- ============ NA STIAHNUTIE ============ -->
  <section class="max-w-[1100px] mx-auto px-4 py-10">
    <h2 class="t-sub text-sm text-ec-yellow">Cenník a tlačivá</h2>
    <div class="mt-5 grid gap-5 md:grid-cols-2">
      {
        NA_STIAHNUTIE.map((s) => (
          <div class="nb-card nb-lift p-6 flex flex-col">
            <div class="flex items-start justify-between gap-3">
              <div class="t-display text-2xl">{s.t}</div>
              {!s.hotove && (
                <span class="nb-tag text-[0.6rem] text-ec-muted shrink-0">Pripravujeme</span>
              )}
            </div>
            <p class="mt-3 text-sm text-ec-ink/75 flex-1">{s.pod}</p>
            <a href={s.href} class="nb-btn-ghost text-xs mt-5 self-start !px-4 !py-2.5">
              {s.akcia}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ SLUŽBY ============ -->
  <section class="max-w-[1100px] mx-auto px-4 py-10">
    <h2 class="t-sub text-sm text-ec-yellow">Čo u nás vybavíte</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class="nb-card nb-lift p-5">
        <div class="nb-tag text-[0.6rem] text-ec-red border-ec-red/50">Úkon kontroly</div>
        <div class="t-display text-xl mt-3">Technická kontrola</div>
        <p class="mt-2 text-sm text-ec-ink/70">Pravidelná, opakovaná aj zvláštna TK.</p>
      </div>
      <div class="nb-card nb-lift p-5">
        <div class="nb-tag text-[0.6rem] text-ec-red border-ec-red/50">Úkon kontroly</div>
        <div class="t-display text-xl mt-3">Emisná kontrola</div>
        <p class="mt-2 text-sm text-ec-ink/70">Benzín, diesel, LPG aj CNG.</p>
      </div>
      {
        SLUZBY.map((s) => (
          <a
            href={s.externa ? s.href : `/sluzby/${s.href}`}
            class="nb-card nb-lift p-5 block"
          >
            <div
              class:list={[
                "nb-tag text-[0.6rem]",
                s.farba === "bg-ec-red"
                  ? "text-ec-red border-ec-red/50"
                  : "text-ec-green border-ec-green/50",
              ]}
            >
              {s.farba === "bg-ec-red" ? "Úkon kontroly" : "Vybavíme"}
            </div>
            <div class="t-display text-xl mt-3">{s.nazov}</div>
            <p class="mt-2 text-sm text-ec-ink/70">{s.popis}</p>
          </a>
        ))
      }
    </div>
    <a href="/sluzby/" class="nb-btn-ghost text-xs mt-6 !px-4 !py-2.5">Podrobne o službách →</a>
  </section>

  <!-- ============ VŠETKY STRÁNKY ============ -->
  <section class="max-w-[1100px] mx-auto px-4 py-10 pb-16">
    <h2 class="t-sub text-sm text-ec-yellow">Všetko ostatné na webe</h2>
    <p class="mt-2 text-sm text-ec-muted max-w-2xl">
      Menu hore má len štyri položky zámerne. Zvyšok webu žije tu.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          { h: "/cennik/", t: "Cenník", pod: "Všetky ceny 2026" },
          { h: "/sluzby/", t: "Služby", pod: "Tachografy, prihlasovanie, výzdvih" },
          { h: "/kontakt/", t: "Kontakt", pod: "Adresa, mapa, otváracie hodiny" },
          ...MIMO_MENU,
          { h: "/uzitocne-informacie/", t: "Užitočné informácie", pod: "Zhrnutie pre vodičov" },
          { h: "/rezervacia-vip/", t: "VIP rezervácia", pod: "Prednostné termíny" },
          { h: "/koleso-stastia/", t: "Koleso šťastia", pod: "Vernostný program" },
        ].map((m) => (
          <a href={m.h} class="nb nb-lift p-4 block">
            <div class="t-sub text-sm text-ec-ink">{m.t}</div>
            <div class="mt-1 text-xs text-ec-muted">{m.pod}</div>
          </a>
        ))
      }
    </div>

    <div class="mt-8 nb p-5">
      <div class="t-sub text-[0.7rem] text-ec-cyan">Overenie na stránkach štátu</div>
      <div class="mt-3 flex flex-col sm:flex-row gap-x-8 gap-y-2 text-sm">
        {
          OVERENIE.map((o) => (
            <a href={o.href} rel="noopener" class="text-ec-cyan hover:text-ec-yellow">
              {o.t} →
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Web>
