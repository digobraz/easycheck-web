---
import InfoStranka from "../layouts/InfoStranka.astro";
import Akordeon from "../components/Akordeon.astro";
---

<InfoStranka
  titul="Povinná výbava vozidla – čo musíte mať v aute"
  popis="Zoznam povinnej výbavy pre osobné aj nákladné vozidlá, autobusy, prípojné vozidlá, motocykle, traktory a pracovné stroje podľa vyhlášky 134/2018 Z. z."
  h1="Povinná výbava"
  odpoved="V osobnom aute musíte mať trojuholník, reflexnú vestu, lekárničku, zdvihák, kľúč na kolesá a náhradné koleso."
  zdroj="vyhlášky 134/2018 Z. z."
>
  <Akordeon otazka="Osobné vozidlá (M1, N1)" otvorene>
    <ul class="list-disc pl-5 space-y-2">
      <li>Prenosný výstražný trojuholník.</li>
      <li>
        Bezpečnostný odev (bezpečnostná reflexná vesta, overal, nohavice,
        bunda alebo pláštenka).
      </li>
      <li>
        Autolekárnička (M1, N, T, C a Ps) – použiteľná a jej obsah musí byť v
        exspiračnej dobe.
      </li>
      <li>Príručný zdvihák.</li>
      <li>Kľúč na matice alebo na skrutky kolies.</li>
      <li>
        Náhradné koleso s diskom a s náhradnou pneumatikou predpísaného druhu
        a rozmeru (neplatí pre vozidlá pneumatikami zvláštnej konštrukcie
        umožňujúcej dočasné použitie po defekte a vozidlá vybavené
        prostriedkami na bezdemontážnu opravu poškodenej pneumatiky).
      </li>
    </ul>
  </Akordeon>

  <Akordeon otazka="Nákladné vozidlá (N2, N3)">
    <p>Povinná výbava je zhodná s osobným vozidlom, s nasledovným rozšírením:</p>
    <ul class="list-disc pl-5 space-y-2 mt-2">
      <li>
        Jeden alebo viac hasiacich prístrojov, ktorých hmotnosť náplní je
        najmenej 6 kg.
      </li>
      <li>
        Jeden zakladací klin pre motorové vozidlo s celkovou hmotnosťou nad
        3,5 t (ľahko prístupný, bezpečný a spoľahlivo upevnený), resp.
        najmenej 2 zakladacie kliny pri motorovom vozidle s troma a viacerými
        nápravami.
      </li>
      <li>
        Len pre kategóriu N3, v čase od 15. novembra do 30. marca, protisklzové
        reťaze určené aspoň pre jednu z hnacích náprav (nevzťahuje sa na
        vozidlá kategórie N3G).
      </li>
    </ul>
    <p class="mt-4 text-sm opacity-80">
      Pozn. Povinnosť vybavenia náhradným kolesom s diskom a pneumatikou
      predpísaného druhu a rozmeru neplatí pre vozidlá prevádzkovateľa so
      zmluvným vzťahom, ktorým má zabezpečenú nepretržitú možnosť opravy
      poškodenej pneumatiky v celej SR, prípadne ak ide o špeciálne vozidlo
      premávajúce len v dosahu servisných služieb prevádzkovateľa.
    </p>
  </Akordeon>

  <Akordeon otazka="Autobusy (M2, M3)">
    <p>Povinná výbava je zhodná s osobným vozidlom, s nasledovným rozšírením:</p>
    <ul class="list-disc pl-5 space-y-2 mt-2">
      <li>
        Jeden alebo viac hasiacich prístrojov, ktorých hmotnosť náplní je
        najmenej 6 kg (M2 a M3 s počtom do 22 miest na sedenie), resp. 12 kg
        (kategórie M2 a M3 s počtom nad 22 miest na sedenie).
      </li>
      <li>
        Jeden zakladací klin pre motorové vozidlo s celkovou hmotnosťou nad
        3,5 t (ľahko prístupný, bezpečný a spoľahlivo upevnený), resp.
        najmenej 2 zakladacie kliny pri motorovom vozidle s troma a viacerými
        nápravami.
      </li>
      <li>
        Pre kategóriu M2, M3 jedna autolekárnička pre hromadnú dopravu / jedna
        lekárnička pre kategóriu motorových vozidiel M2, M3 s počtom do 22
        miest na sedenie. Nad 22 miest na sedenie sú povinné dve
        autolekárničky pre hromadnú dopravu / dve lekárničky pre kategóriu
        motorových vozidiel M2, M3.
      </li>
    </ul>
    <p class="mt-4 text-sm opacity-80">
      Pozn. Povinnosť vybavenia náhradným kolesom s diskom a pneumatikou
      predpísaného druhu a rozmeru neplatí pre vozidlá prevádzkovateľa so
      zmluvným vzťahom, ktorým má zabezpečenú nepretržitú možnosť opravy
      poškodenej pneumatiky v celej SR, prípadne ak ide o špeciálne vozidlo
      premávajúce len v dosahu servisných služieb prevádzkovateľa.
    </p>
  </Akordeon>

  <Akordeon otazka="Prípojné vozidlá (O2 – O4, Rb2 – Rb4)">
    <ul class="list-disc pl-5 space-y-2">
      <li>
        Náhradné koleso s diskom a s pneumatikou predpísaného druhu a
        rozmeru; jazdná súprava zložená z ťahača a prípojného vozidla môže mať
        pri rovnakých rozmeroch pneumatík a pri rovnakom vyhotovení kolies
        jedno spoločné náhradné koleso.
      </li>
      <li>
        Jeden zakladací klin pri prípojnom vozidla s celkovou hmotnosťou nad
        750 kg, pri prípojnom vozidle s troma a viacerými nápravami,
        jednonápravovom prívese s celkovou hmotnosťou nad 750 kg a návese sú
        najmenej dva zakladacie kliny.
      </li>
    </ul>
  </Akordeon>

  <Akordeon otazka="Motocykle (L3e, L4e, L5e, L7e)">
    <p>
      Motolekárnička / lekárnička pre kategóriu motorových vozidiel L3e až
      L5e a L7e.
    </p>
  </Akordeon>

  <Akordeon otazka="Traktory a pracovné stroje (T, Ps)">
    <ul class="list-disc pl-5 space-y-2">
      <li>
        Autolekárnička / lekárnička pre kategóriu motorových vozidiel M1, N,
        T, C a Ps (použiteľná a jej obsah musí byť v exspiračnej dobe).
      </li>
      <li>Prenosný výstražný trojuholník schválený podľa predpisu EHK 27.</li>
      <li>
        Bezpečnostný odev (bezpečnostná reflexná vesta, overal, nohavice,
        bunda alebo pláštenka), pričom bezpečnostný odev sa umiestňuje v
        dosahu zo sedadla vodiča vozidla.
      </li>
      <li>
        Jeden alebo viac hasiacich prístrojov, ktorých hmotnosť náplní je
        najmenej 6 kg.
      </li>
      <li>
        Jeden zakladací klin pre traktory s celkovou hmotnosťou nad 3,5 t,
        ktorý účinne zabezpečí vozidlo proti samovoľnému pohybu a je ľahko
        prístupný, bezpečný a spoľahlivo upevnený.
      </li>
    </ul>
    <p class="mt-4 text-sm opacity-80">
      Chýbajúca alebo neplatná povinná výbava je bežný dôvod, prečo vozidlo na
      technickej kontrole neprejde. Skontrolujte si ju pred návštevou STK.
    </p>
  </Akordeon>
</InfoStranka>
