---
/**
 * Akordeón = natívny <details>. Zabalený pre oko, ale celý text je v HTML —
 * Google ho číta bez ohľadu na to, či je otvorený. Žiadny JS.
 */
interface Props {
  otazka: string;
  otvorene?: boolean;
}
const { otazka, otvorene = false } = Astro.props;
---

<details class="nb group border-b-0 last:border-b-[var(--stroke)]" open={otvorene}>
  <summary
    class="cursor-pointer list-none flex items-start justify-between gap-4 px-5 py-4 t-sub text-sm md:text-base select-none hover:bg-ec-yellow/40 transition-colors"
  >
    <span>{otazka}</span>
    <span
      class="shrink-0 w-6 h-6 border-[var(--stroke)] border-ec-ink flex items-center justify-center text-lg leading-none bg-ec-paper group-open:bg-ec-ink group-open:text-ec-paper"
      aria-hidden="true">+</span
    >
  </summary>
  <div class="ec-proza px-5 pb-5 pt-1 border-t border-ec-ink/15">
    <slot />
  </div>
</details>

<style is:global>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
