---
/**
 * Hlavička — 4 piliere + jedno žlté tlačidlo.
 * Tmavý HUD: priehľadný panel s blur, spodná svetelná linka.
 */
import { MENU, KONTAKT, REZERVACIA } from "../data/firma";

const { cesta = "" } = Astro.props;
const je = (h: string) => h !== "/" && cesta.startsWith(h.replace(/\/$/, ""));
---

<header
  class="sticky top-0 z-50 border-b border-ec-cyan/25 bg-[rgb(5_8_10/0.88)] backdrop-blur-md"
>
  <div class="max-w-[1200px] mx-auto px-4 h-[72px] flex items-center justify-between gap-4">
    <a href="/" class="flex items-center shrink-0" aria-label="Easy Check — domov">
      <img src="/brand/easycheck-logo.svg" alt="Easy Check" class="h-9 md:h-11 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Hlavné menu">
      {
        MENU.map((n) => (
          <a
            href={n.h}
            aria-current={je(n.h) ? "page" : undefined}
            class:list={[
              "t-sub text-xs px-4 py-2.5 border transition-colors",
              je(n.h)
                ? "border-ec-yellow/60 text-ec-yellow bg-[rgb(255_230_0/0.07)]"
                : "border-transparent text-ec-ink/80 hover:border-ec-cyan/40 hover:text-ec-cyan",
            ]}
          >
            {n.t}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href={KONTAKT.telHref}
        class="hidden md:inline t-sub text-xs px-2 py-2 text-ec-ink/80 hover:text-ec-yellow"
      >
        {KONTAKT.tel}
      </a>
      <a href={REZERVACIA} class="nb-btn text-xs md:text-sm !px-4 md:!px-5 !py-2.5"
        >Rezervovať</a
      >
      <button
        id="ec-burger"
        class="lg:hidden nb w-11 h-11 flex items-center justify-center"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="ec-menu"
      >
        <span
          class="block w-5 h-[2px] bg-ec-ink relative before:absolute before:content-[''] before:w-5 before:h-[2px] before:bg-ec-ink before:-top-1.5 after:absolute after:content-[''] after:w-5 after:h-[2px] after:bg-ec-ink after:top-1.5"
        ></span>
      </button>
    </div>
  </div>

  <nav
    id="ec-menu"
    class="hidden lg:hidden border-t border-ec-cyan/25 bg-[rgb(5_8_10/0.97)]"
    aria-label="Mobilné menu"
  >
    {
      MENU.map((n) => (
        <a
          href={n.h}
          class:list={[
            "block t-sub text-sm px-4 py-3.5 border-b border-ec-cyan/15",
            je(n.h) ? "text-ec-yellow" : "text-ec-ink/85",
          ]}
        >
          {n.t}
        </a>
      ))
    }
    <a
      href={KONTAKT.telHref}
      class="block t-sub text-sm px-4 py-3.5 text-ec-cyan border-b border-ec-cyan/15"
    >
      Zavolať {KONTAKT.tel}
    </a>
  </nav>
</header>

<script is:inline>
  (() => {
    const b = document.getElementById("ec-burger");
    const m = document.getElementById("ec-menu");
    if (!b || !m) return;
    b.addEventListener("click", () => {
      const open = m.classList.toggle("hidden") === false;
      b.setAttribute("aria-expanded", String(open));
    });
  })();
</script>
