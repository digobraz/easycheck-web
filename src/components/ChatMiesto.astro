---
/**
 * Odkaz na CHAT — pilier č. 3.
 *
 * Chat sám ešte neodpovedá (nemá znalostnú bázu ani backend), ale stránka
 * `/chat/` už existuje a je plnohodnotná: cenník, služby, tlačivá, rozcestník
 * na všetko mimo menu. Tento blok tam preto posiela, nie „drží priestor".
 */
import { KONTAKT } from "../data/firma";

interface Props {
  /** veľký = plná verzia na /uzitocne-informacie/, malý = pás na info stránkach */
  velky?: boolean;
  otazky?: string[];
}
const {
  velky = false,
  otazky = ["Kedy ide moje auto na STK?", "Čo si mám vziať so sebou?", "Koľko to stojí?"],
} = Astro.props;
---

<div
  class:list={["nb relative border-ec-cyan/50", velky ? "p-6 md:p-10" : "p-5 md:p-6"]}
  data-chat-placeholder
>
  <span class="nb-corner top-2 left-2 border-r-0 border-b-0"></span>
  <span class="nb-corner bottom-2 right-2 border-l-0 border-t-0"></span>

  <div class="t-sub text-[0.7rem] text-ec-cyan">Easy Check · asistent</div>
  <div class:list={["t-display", velky ? "text-3xl md:text-5xl mt-2" : "text-xl md:text-2xl mt-1"]}>
    Opýtajte sa <span class="t-glow-y">na čokoľvek</span>
  </div>
  <p class:list={["mt-3 text-ec-ink/80", velky ? "text-base md:text-lg max-w-2xl" : "text-sm"]}>
    Cenník, služby, lehoty, tlačivá aj všetky ostatné stránky nájdete na jednom mieste.
  </p>

  {
    velky && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {otazky.map((o) => (
          <li class="nb-tag normal-case tracking-normal font-normal text-ec-ink/85">{o}</li>
        ))}
      </ul>
    )
  }

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a href="/chat/" class="nb-btn text-sm">Otvoriť chat</a>
    <a href={KONTAKT.telHref} class="nb-btn-ghost text-sm">Zavolať {KONTAKT.tel}</a>
  </div>
</div>
