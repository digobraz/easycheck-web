---
/**
 * Miesto pre chat. Chat sa v NOCI 1 NEROBÍ — potrebuje znalostnú bázu
 * rozobratú fakt po fakte + testovanie (plan.html §02). Toto je len blok,
 * ktorý drží priestor a zatiaľ posiela človeka na telefón.
 */
import { KONTAKT } from "../data/firma";

interface Props {
  /** veľký = plná verzia na /uzitocne-informacie/, malý = pás na info stránkach */
  velky?: boolean;
  otazky?: string[];
}
const {
  velky = false,
  otazky = ["Kedy ide moje auto na STK?", "Čo si mám vziať so sebou?", "Koľko to stojí?"],
} = Astro.props;
---

<div
  class:list={[
    "nb-card bg-ec-cyan text-white",
    velky ? "p-6 md:p-10" : "p-5 md:p-6",
  ]}
  data-chat-placeholder
>
  <div class="t-sub text-xs text-white/80">Pripravujeme</div>
  <div class:list={["t-display", velky ? "text-3xl md:text-5xl mt-2" : "text-xl md:text-2xl mt-1"]}>
    Opýtaj sa na čokoľvek
  </div>
  <p class:list={["mt-3 text-white/90", velky ? "text-base md:text-lg max-w-2xl" : "text-sm"]}>
    Chat, ktorý odpovie z overených faktov a ku každej odpovedi dá zdroj a dátum overenia.
    Zatiaľ nebeží — kým nie je istý, radšej vás spojíme s technikom.
  </p>

  {
    velky && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {otazky.map((o) => (
          <li class="nb-tag bg-white/95 text-ec-ink normal-case tracking-normal font-normal">
            „{o}“
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a href={KONTAKT.telHref} class="nb-btn text-sm">Zavolať {KONTAKT.tel}</a>
    <span class="text-xs text-white/80">{velky ? "Po–Pia 07:00–19:00 · So 07:00–13:00" : ""}</span>
  </div>
</div>
