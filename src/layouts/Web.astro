---
/**
 * Základný layout pre všetky podstránky (homepage NIE — tá je zrkadlo hero
 * prototypu v public/index.html a needituje sa tu).
 *
 * Celý web je noindex — testovacia doména stk.digobraz.sk nesmie
 * kanibalizovať živý easycheck.sk. Zrušiť až pri prepnutí domény.
 */
import "../styles/global.css";
import Hlavicka from "../components/Hlavicka.astro";
import Pata from "../components/Pata.astro";

interface Props {
  titul: string;
  popis: string;
  /** trieda pozadia <body> */
  bg?: string;
  /**
   * Obsah meta robots. Default drží celý web mimo indexu, kým beží na testovacej
   * doméne. Pri prepnutí na ostrý easycheck.sk sa mení TU — a stránky, ktoré majú
   * ostať mimo indexu navždy, si `robots` posielajú vlastný (napr. prázdny článok).
   */
  robots?: string;
}

const { titul, popis, bg = "bg-ec-paper", robots = "noindex, nofollow" } = Astro.props;
const cesta = Astro.url.pathname;
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titul}</title>
    <meta name="description" content={popis} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={titul} />
    <meta property="og:description" content={popis} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sk_SK" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@600;700;800&family=DM+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class={bg}>
    <a
      href="#obsah"
      class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:m-3 focus:nb focus:px-4 focus:py-2"
      >Preskočiť na obsah</a
    >
    <Hlavicka cesta={cesta} />
    <main id="obsah">
      <slot />
    </main>
    <Pata />
  </body>
</html>
